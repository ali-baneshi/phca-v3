{
  "manifest_version": 1,
  "phca_version": "3.0",
  "environment": {
    "python": "3.11",
    "mujoco_gl": "disabled",
    "requirements": [
      "requirements.txt",
      "requirements-dev.txt",
      "requirements-mujoco.txt"
    ],
    "defaults": {
      "PYTHONPATH": "python",
      "MUJOCO_GL": "disabled"
    }
  },
  "profiles": {
    "quick": {
      "description": "CI-science subset (~10-15 min): lint, pytest, quick Φ-IQ gate, causal smoke, assumption/OOD/anomaly gates",
      "runtime_estimate_s": 900,
      "steps": [
        {
          "id": "lint",
          "name": "Python lint (ruff)",
          "command": "ruff check python/ --no-cache",
          "outputs": [],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 10
        },
        {
          "id": "test_python",
          "name": "Python test suite (CI-equivalent)",
          "command": "python -m pytest python/tests/ python/phca/ -v --tb=short --timeout=30 -x --benchmark-skip",
          "outputs": [],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 420
        },
        {
          "id": "benchmark_quick_gate",
          "name": "L0 Φ-IQ quick regression gate",
          "command": "python scripts/benchmark.py --quick --output=logs/benchmark_report.json",
          "outputs": ["logs/benchmark_report.json"],
          "verify": {
            "type": "gate_script",
            "argv": [
              "python",
              "scripts/check_benchmark_gate.py",
              "logs/benchmark_report.json",
              "logs/benchmark_ci_baseline.json"
            ]
          },
          "gates": {
            "phi_iq_floor": "logs/benchmark_ci_baseline.json",
            "tolerance": 0.05
          },
          "runtime_estimate_s": 5
        },
        {
          "id": "causal_smoke",
          "name": "Causal L2 smoke (10 cycles × 1 seed)",
          "command": "python scripts/phca_causal_eval.py --levels level2 --cycles 10 --seeds 1 --output logs/phca_causal_eval_smoke.json",
          "outputs": ["logs/phca_causal_eval_smoke.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 30
        },
        {
          "id": "assumption_ci",
          "name": "Assumption validation A1-A5 (--ci)",
          "command": "python scripts/assumption_validation.py --ci --output=logs/nightly_assumptions.json",
          "outputs": ["logs/nightly_assumptions.json"],
          "env": { "PYTHONPATH": "python:scripts" },
          "verify": { "type": "exit_code" },
          "gates": { "all_experiments_pass": true },
          "runtime_estimate_s": 120
        },
        {
          "id": "ood_calibration",
          "name": "OOD calibration (σ-sweep monotonicity)",
          "command": "python scripts/ood_calibration.py --output=logs/nightly_ood.json",
          "outputs": ["logs/nightly_ood.json"],
          "verify": { "type": "exit_code" },
          "gates": {
            "blended_monotonic_non_increasing": true,
            "blended_drop_gt_zero": true
          },
          "runtime_estimate_s": 180
        },
        {
          "id": "anomaly_gate",
          "name": "Session anomaly gate (synthetic fixtures)",
          "command": "python scripts/nightly_anomaly_gate.py --output=logs/nightly_anomaly_gate.json",
          "outputs": ["logs/nightly_anomaly_gate.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 5
        }
      ]
    },
    "full": {
      "description": "Nightly-equivalent scientific validation (~45-90 min): canonical Φ-IQ, MuJoCo gates, stress soak, causal gate",
      "runtime_estimate_s": 5400,
      "steps": [
        {
          "id": "benchmark_canonical",
          "name": "Canonical Φ-IQ benchmark (MLP 200 cyc L0-L3)",
          "command": "python scripts/benchmark.py --use-mlp --cycles=200 --output=logs/benchmark_report.json",
          "outputs": ["logs/benchmark_report.json"],
          "verify": {
            "type": "gate_script",
            "argv": [
              "python",
              "scripts/check_benchmark_gate.py",
              "logs/benchmark_report.json",
              "logs/benchmark_ci_baseline.json"
            ]
          },
          "gates": {
            "phi_iq_floor": "logs/benchmark_ci_baseline.json",
            "tolerance": 0.05
          },
          "runtime_estimate_s": 60
        },
        {
          "id": "nightly_static_gate",
          "name": "Nightly static Φ-IQ (200cyc MLP)",
          "command": "python scripts/benchmark.py --use-mlp --cycles=200 --output=logs/nightly_static.json",
          "outputs": ["logs/nightly_static.json"],
          "verify": {
            "type": "gate_script",
            "argv": [
              "python",
              "scripts/check_benchmark_gate.py",
              "logs/nightly_static.json",
              "logs/benchmark_ci_baseline.json"
            ]
          },
          "gates": {
            "phi_iq_floor": "logs/benchmark_ci_baseline.json",
            "tolerance": 0.05
          },
          "runtime_estimate_s": 60
        },
        {
          "id": "mujoco_pendulum",
          "name": "MuJoCo benchmark — Pendulum",
          "command": "python scripts/benchmark.py --env pendulum --use-mlp --cycles=100 --output=logs/nightly_mujoco_pendulum.json",
          "outputs": ["logs/nightly_mujoco_pendulum.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 120
        },
        {
          "id": "mujoco_cartpole",
          "name": "MuJoCo benchmark — Cartpole",
          "command": "python scripts/benchmark.py --env cartpole --use-mlp --cycles=100 --output=logs/nightly_mujoco_cartpole.json",
          "outputs": ["logs/nightly_mujoco_cartpole.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 120
        },
        {
          "id": "mujoco_reacher",
          "name": "MuJoCo benchmark — Reacher",
          "command": "python scripts/benchmark.py --env reacher --use-mlp --cycles=100 --output=logs/nightly_mujoco_reacher.json",
          "outputs": ["logs/nightly_mujoco_reacher.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 120
        },
        {
          "id": "mujoco_gate",
          "name": "MuJoCo benchmark gate (violations + error trend)",
          "command": "python scripts/check_benchmark_gate.py --mujoco logs/nightly_mujoco_pendulum.json logs/nightly_mujoco_cartpole.json logs/nightly_mujoco_reacher.json",
          "outputs": [],
          "verify": { "type": "exit_code" },
          "gates": {
            "violations_zero": true,
            "error_improved": true,
            "no_errors": true
          },
          "runtime_estimate_s": 1
        },
        {
          "id": "mujoco_neg_test",
          "name": "MuJoCo gate negative self-test",
          "command": "python scripts/check_benchmark_gate.py --neg-test",
          "outputs": [],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 1
        },
        {
          "id": "assumption_ci",
          "name": "Assumption validation A1-A5 (--ci)",
          "command": "python scripts/assumption_validation.py --ci --output=logs/nightly_assumptions.json",
          "outputs": ["logs/nightly_assumptions.json"],
          "env": { "PYTHONPATH": "python:scripts" },
          "verify": { "type": "exit_code" },
          "gates": { "all_experiments_pass": true },
          "runtime_estimate_s": 120
        },
        {
          "id": "ood_calibration",
          "name": "OOD calibration (σ-sweep monotonicity)",
          "command": "python scripts/ood_calibration.py --output=logs/nightly_ood.json",
          "outputs": ["logs/nightly_ood.json"],
          "verify": { "type": "exit_code" },
          "gates": {
            "blended_monotonic_non_increasing": true,
            "blended_drop_gt_zero": true
          },
          "runtime_estimate_s": 180
        },
        {
          "id": "nightly_stress",
          "name": "Nightly stress soak (10k cycles)",
          "command": "python scripts/nightly_stress.py --output=logs/nightly_stress.json",
          "outputs": ["logs/nightly_stress.json"],
          "env": { "NIGHTLY_CYCLES": "10000" },
          "verify": { "type": "exit_code" },
          "gates": {
            "leak_slope_late_b_per_cyc": 1600,
            "leak_slope_fill_b_per_cyc": 5000,
            "p95_latency_ms": 500,
            "violation_rate": 0.1
          },
          "runtime_estimate_s": 180
        },
        {
          "id": "causal_gate",
          "name": "Causal behavior gate (L2+L3, 200cyc × 5 seeds)",
          "command": "python scripts/phca_causal_eval.py --levels level2,level3 --cycles 200 --seeds 5 --use-mlp --gate --output logs/phca_causal_eval_nightly.json",
          "outputs": ["logs/phca_causal_eval_nightly.json"],
          "verify": { "type": "exit_code" },
          "gates": { "causal_75pct_rule": true },
          "runtime_estimate_s": 1800
        },
        {
          "id": "anomaly_gate",
          "name": "Session anomaly gate (synthetic fixtures)",
          "command": "python scripts/nightly_anomaly_gate.py --output=logs/nightly_anomaly_gate.json",
          "outputs": ["logs/nightly_anomaly_gate.json"],
          "verify": { "type": "exit_code" },
          "runtime_estimate_s": 5
        }
      ]
    }
  }
}
