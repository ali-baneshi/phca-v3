        I8["CR: phi_current"]
        I9["ATTN: chunks, goal, k"]
        I10["RBTA: runtime, memory, energy"]
    end

    subgraph OUT["خروجی‌های هر مؤلفه"]
        O1["ASI: StateVector, status"]
        O2["M2: Chunk, is_full"]
        O3["G': StateVector, confidence"]
        O4["PE: StateVector, confidence"]
