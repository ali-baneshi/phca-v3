flowchart LR
    subgraph IN["ورودی‌های هر مؤلفه"]
        I1["ASI: raw_sensor, timestamp"]
        I2["M2: StateVector, salience"]
        I3["G': StateVector, action"]
        I4["PE: StateVector, horizon"]
        I5["PEU: observed, predicted"]
        I6["TSPL: error, state, pred"]
